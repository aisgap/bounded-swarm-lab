# Server-only OpenAI credential. Never expose this value to browser code.
OPENAI_API_KEY=

# Live provider dispatch remains disabled unless this is exactly "true".
SWARM_LIVE_ENABLED=false

# Public clones begin with zero authorized provider spend. Both values must be
# explicitly set by the deployment owner before Live can reserve any work.
# The built-in pilot profile permits at most 10000000 micro-USD ($10).
SWARM_AUTHORIZED_MICROUSD=0
SWARM_START_THRESHOLD_MICROUSD=0

# Allowlisted model used by the bounded experiment profile.
SWARM_MODEL=gpt-6-luna
